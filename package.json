{
  "name": "think-browser",
  "productName": "Think-Browser",
  "version": "2.0.0",
  "description": "Navigateur de bureau sombre, modulaire et moderne construit avec Electron.",
  "homepage": "https://think-browser.example",
  "desktopName": "Think-Browser",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/buildRenderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predev": "npm run build:renderer",
    "dev": "electron .",
    "precheck": "npm run build:renderer",
    "check": "node scripts/check.js",
    "audit:security": "node scripts/securityAudit.js",
    "audit:dependencies": "npm audit",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run build:renderer",
    "pack": "electron-builder --dir",
    "predist": "npm run build:renderer",
    "dist": "electron-builder",
    "predist:linux": "npm run build:renderer",
    "dist:linux": "electron-builder --linux",
    "predist:win": "npm run build:renderer",
    "dist:win": "electron-builder --win",
    "pretest:integration": "npm run build:renderer",
    "test:integration": "node scripts/integrationSmoke.js"
  },
  "keywords": [
    "electron",
    "browser",
    "navigateur",
    "adblock",
    "architecture-modulaire"
  ],
  "author": "Think-Browser",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "cross-fetch": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.thinkbrowser.app",
    "productName": "Think-Browser",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/afterPack.js",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!scripts/**",
      "!**/*.log",
      "!**/.git/**",
      "!**/node_modules/.cache/**",
      "!node_modules/ffmpeg-static/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/ffprobe-static/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icon.png",
      "synopsis": "Navigateur de bureau sombre, modulaire et moderne.",
      "description": "Think-Browser est un navigateur de bureau basé sur Electron, avec navigation privée, téléchargements HLS/DASH, médiathèque et lecteur intégré.",
      "maintainer": "Think-Browser <contact@think-browser.example>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Think-Browser",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
